generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  role          String    @default("CLIENT") // ADMIN, MANAGER, EMPLOYEE, CLIENT
  avatar        String?
  initials      String?   @default("AY")
  phone         String?
  company       String?   @default("Cairo Fresh Market")
  clientSince   String?   @default("Nov 2025")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  managedProjects Project[] @relation("ProjectManager")
  tasks         Task[]    @relation("TaskAssignee")
  notes         Note[]
  documents     Document[]
  clients       Client[]  @relation("ClientPortalUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  address   String?
  notes     String?
  userId    String?  @unique
  user      User?    @relation("ClientPortalUser", fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]
  invoices  Invoice[]
  quotations Quotation[]
}

model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  type           String        @default("website") // website, mobile, automation, desktop
  status         String        @default("requested") // requested, in_review, in_progress, completed
  progress       Int           @default(0)
  budget         Float?        @default(0)
  paid           Float         @default(0)
  contractDate   String?
  contractStatus String?       @default("Active")
  requestDate    String?
  duration       String?
  totalDays      Int?          @default(30)
  versionLabel   String?
  versionNote    String?
  quotationItems String?       @default("[]") // JSON string of [{item, amount}]
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  managerId      String?
  manager        User?         @relation("ProjectManager", fields: [managerId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  stages         ProjectStage[]
  tasks          Task[]
  notes          Note[]
  invoices       Invoice[]
  quotations     Quotation[]
  documents      Document[]
  payments       Payment[]
  fastFixIssues  FastFixIssue[]
  extensions     ProjectExtension[]
}

model ProjectStage {
  id        String      @id @default(cuid())
  name      String
  status    String      @default("pending") // done, current, pending
  order     Int
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      String     @default("TODO")
  priority    String     @default("MEDIUM")
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Note {
  id        String     @id @default(cuid())
  text      String
  author    String     @default("client") // client, team
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?      @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id])
  amount        Float
  status        String        @default("DRAFT")
  dueDate       DateTime?
  paidDate      DateTime?
  items         String        @default("[]")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payments      Payment[]
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String?
  invoice   Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount    Float
  method    String
  note      String?
  date      String?
  createdAt DateTime      @default(now())
}

model Quotation {
  id          String          @id @default(cuid())
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?        @relation(fields: [projectId], references: [id])
  title       String
  description String?
  items       String          @default("[]")
  totalPrice  Float
  discount    Float           @default(0)
  finalPrice  Float
  status      String          @default("DRAFT")
  validUntil  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Document {
  id           String   @id @default(cuid())
  name         String
  type         String
  url          String
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String        @default("NEW")
  createdAt DateTime      @default(now())
}

model FastFixIssue {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String    @default("Fast Fixing Issue")
  description     String
  photoUrl        String?
  status          String    @default("pending") // pending, on_it, fixed
  startedAt       DateTime?
  resolvedAt      DateTime?
  durationMinutes Int?
  adminNotes      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ProjectExtension {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  description    String
  status         String    @default("requested") // requested, in_progress, completed, merged
  progress       Int       @default(0) // 0 to 100
  budget         Float     @default(0)
  paid           Float     @default(0)
  targetDays     Int?      @default(15)
  versionTarget  String?   @default("v1.1")
  notes          String?
  payments       String?   @default("[]") // JSON string of [{id, amount, date, method, note}]
  stages         String?   @default("[]") // JSON string of [{name, status, order}]
  mergedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

